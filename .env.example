# Copy this file to .env and fill in your model service configuration.
# Load .env with python-dotenv's load_dotenv() in the application.
OPENAI_API_KEY=

# Application setting: pass this value explicitly as the model name.
OPENAI_MODEL=

# Optional: uncomment for a service implementing the required API protocol.
# OPENAI_BASE_URL=https://your-api-host.example/v1

# Keep remote tracing disabled for local development.
LANGSMITH_TRACING=false
